# Copiar a .env y completar. .env nunca se versiona.

# Dominio del VPS; Caddy saca el certificado solo.
APP_DOMAIN=notia.tudominio.com
APP_BASE_URL=https://notia.tudominio.com

POSTGRES_PASSWORD=cambiame

# Contraseña única de la app (un solo usuario).
APP_PASSWORD=cambiame
# Secreto del servidor: firma la cookie de sesión y los tokens de deshacer.
# Generar con: openssl rand -base64 32
APP_SECRET=cambiame

# Token que Evolution manda en el header `apikey` al pegarle al webhook.
WEBHOOK_TOKEN=cambiame

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna
COMPACT_THRESHOLD=40000

EVOLUTION_API_KEY=cambiame
EVOLUTION_INSTANCE=notia
# Tu propio JID: acá llegan todos los avisos del sistema.
MI_JID=5491100000000@s.whatsapp.net

TZ_USUARIO=America/Argentina/Buenos_Aires
# Cuántos minutos antes del vencimiento avisar.
LEAD_MINUTOS=60
