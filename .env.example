# Copiar a .env y completar. El .env nunca se versiona.
#
#   cp .env.example .env
#
# Generar los secretos con:  openssl rand -base64 32

# ─────────────────────────────────────────────────────────────────────────
# Stack base (docker-compose.yml) — frontend + backend + base de datos.
# Con estas cuatro variables el sistema levanta y se usa. Nada de acá
# depende de un servicio de terceros.
# ─────────────────────────────────────────────────────────────────────────

POSTGRES_PASSWORD=cambiame

# Contraseña única de la app (es de un solo usuario).
APP_PASSWORD=cambiame

# Secreto del servidor: firma la cookie de sesión y los tokens de deshacer.
APP_SECRET=cambiame

# Token que el gateway de WhatsApp manda en el header `apikey` al webhook.
# La API lo exige aunque el webhook no se use: poné cualquier valor.
WEBHOOK_TOKEN=cambiame

# Puerto donde queda publicada la app. http://localhost:8080
WEB_PORT=8080

# ─────────────────────────────────────────────────────────────────────────
# Capa opcional (docker-compose.full.yml) — ingesta por WhatsApp.
# Solo hace falta si levantás el stack completo. Requiere una API key de
# OpenAI con saldo y escanear un QR de WhatsApp.
# ─────────────────────────────────────────────────────────────────────────

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.6-luna
# COMPACT_THRESHOLD=40000

# EVOLUTION_API_KEY=cambiame
# EVOLUTION_INSTANCE=notia
# EVOLUTION_PORT=8081

# Tu propio JID: acá llegan todos los avisos del sistema.
# MI_JID=5491100000000@s.whatsapp.net

# TZ_USUARIO=America/Argentina/Buenos_Aires
# Cuántos minutos antes del vencimiento avisar.
# LEAD_MINUTOS=60

# Solo para el despliegue en un VPS con dominio propio (perfil `produccion`).
# APP_DOMAIN=notia.tudominio.com
# APP_BASE_URL=https://notia.tudominio.com
