{
  "name": "notia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "test": "vitest run",
    "build:web": "pnpm --filter @notia/web build",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/api && tsc --noEmit -p packages/worker && tsc --noEmit -p packages/web",
    "db:generate": "drizzle-kit generate --config=packages/core/drizzle.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
